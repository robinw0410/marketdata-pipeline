# Installed as /etc/marketdata.env (EnvironmentFile of marketdata-collector.service
# and, optional, marketdata-calendar.service).
# The file must exist for the collector unit to start, but it may be empty.
# Optional: Uptime Kuma push monitor URL (contains a token). Unset = no heartbeat.
KUMA_PUSH_URL=https://CHANGE_ME/api/push/CHANGE_ME
# FRED API key for scripts/fetch_calendar.py (marketdata-calendar.service).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=CHANGE_ME
