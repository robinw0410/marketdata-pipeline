# /etc/systemd/system/marketdata-compact.service
[Unit]
Description=Compact completed live-collector UTC days to Parquet

[Service]
Type=oneshot
User=mkt
Group=mkt
ExecStart=/opt/marketdata/.venv/bin/python \
    /opt/marketdata/scripts/compact_live.py --symbol BTCUSDT --interval 1m
ExecStart=/opt/marketdata/.venv/bin/python \
    /opt/marketdata/scripts/compact_live.py --symbol ETHUSDT --interval 1m
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/marketdata/data
