# /etc/systemd/system/marketdata-collector.service
[Unit]
Description=Binance kline collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mkt
Group=mkt
EnvironmentFile=/etc/marketdata.env
ExecStart=/opt/marketdata/.venv/bin/python \
    /opt/marketdata/scripts/collect_klines.py --symbols BTCUSDT ETHUSDT --interval 1m
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/marketdata/data

[Install]
WantedBy=multi-user.target
